# Galera cluster environment template
# Copy to .env.galera, fill in real values, then run docker compose.

# ---- Database credentials ----
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=arctic_wolves
MYSQL_USER=arctic_wolves_user
MYSQL_PASSWORD=change_this_user_password

# ---- Cluster identity ----
GALERA_CLUSTER_NAME=arctic_wolves_cluster

# All three node hostnames or IPs (must be reachable from every node).
# Use Docker service names when all nodes are on the same Docker network.
GALERA_CLUSTER_MEMBERS=galera-node-1,galera-node-2,galera-node-3

# ---- Exposed MySQL ports on the Docker host ----
NODE1_PORT=3306
NODE2_PORT=3307
NODE3_PORT=3308
PROXY_MYSQL_PORT=3305
PROXY_ADMIN_PORT=6032

# ---- Bootstrap flag ----
# Set to 'yes' ONLY when creating the cluster for the first time.
# Leave empty for all subsequent starts.
BOOTSTRAP_CLUSTER=
