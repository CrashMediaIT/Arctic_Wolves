# ProxySQL configuration for MariaDB Galera Cluster
# Routes all write traffic to the primary host group (any Galera node)
# and distributes read traffic across all healthy nodes.

datadir = "/var/lib/proxysql"

admin_variables =
{
    admin_credentials = "admin:admin_password"
    mysql_ifaces       = "0.0.0.0:6032"
}

mysql_variables =
{
    threads          = 4
    max_connections  = 2048
    default_query_delay      = 0
    default_query_timeout    = 36000000
    have_compress    = true
    poll_timeout     = 2000
    interfaces       = "0.0.0.0:6033;/tmp/proxysql.sock"
    default_schema   = "arctic_wolves"
    stacksize        = 1048576
    server_version   = "8.0.27"
    connect_timeout_server = 3000
    monitor_username = "monitor"
    monitor_password = "monitor_password"
    monitor_history  = 600000
    monitor_connect_interval    = 60000
    monitor_ping_interval       = 10000
    monitor_read_only_interval  = 1500
    monitor_read_only_timeout   = 500
    ping_interval_server_msec   = 10000
    ping_timeout_server         = 200
    commands_stats              = true
    sessions_sort               = true
    connect_retries_on_failure  = 10
}

# All Galera nodes are peers; all are placed in both the write (hg=10)
# and read (hg=20) host groups so any node can serve reads.
mysql_servers =
(
    { address="galera-node-1", port=3306, hostgroup=10, max_connections=100, weight=100 },
    { address="galera-node-2", port=3306, hostgroup=10, max_connections=100, weight=100 },
    { address="galera-node-3", port=3306, hostgroup=10, max_connections=100, weight=100 },
    { address="galera-node-1", port=3306, hostgroup=20, max_connections=100, weight=100 },
    { address="galera-node-2", port=3306, hostgroup=20, max_connections=100, weight=100 },
    { address="galera-node-3", port=3306, hostgroup=20, max_connections=100, weight=100 }
)

mysql_users =
(
    { username="arctic_wolves_user", password="CHANGE_ME", default_hostgroup=10, transaction_persistent=1 }
)

# Route SELECT statements to the read host group; everything else goes to
# the write host group (which also includes all nodes, so a failing node is
# automatically skipped).
mysql_query_rules =
(
    {
        rule_id     = 1
        active      = 1
        match_pattern = "^SELECT .* FOR UPDATE"
        destination_hostgroup = 10
        apply       = 1
    },
    {
        rule_id     = 2
        active      = 1
        match_pattern = "^SELECT"
        destination_hostgroup = 20
        apply       = 1
    }
)
