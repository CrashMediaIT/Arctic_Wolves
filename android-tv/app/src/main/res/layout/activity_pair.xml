<?xml version="1.0" encoding="utf-8"?>
<!--
  Pairing screen layout for Android TV.
  Centred card with API key input, pair code input, and connect button.
  Designed for D-pad / remote navigation with large touch targets.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <LinearLayout
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="48dp"
        android:background="@drawable/card_background"
        android:gravity="center_horizontal">

        <!-- Logo -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="16dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginBottom="8dp" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pair_subtitle"
            android:textSize="15sp"
            android:textColor="@color/text_muted"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- Error message (hidden by default) -->
        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="@color/error"
            android:background="@drawable/error_background"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

        <!-- API Key input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/api_key_label"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/apiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="@string/api_key_hint"
            android:inputType="textVisiblePassword"
            android:maxLines="1"
            android:textSize="16sp"
            android:textColor="@color/primary_light"
            android:textColorHint="@color/text_muted"
            android:background="@drawable/input_background"
            android:padding="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="16dp"
            android:autofillHints="password"
            android:importantForAutofill="no" />

        <!-- Pair code input -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pair_code_label"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/pairCodeInput"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:hint="@string/pair_code_hint"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:maxLength="10"
            android:maxLines="1"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="@color/primary_light"
            android:textColorHint="@color/text_muted"
            android:fontFamily="monospace"
            android:letterSpacing="0.3"
            android:gravity="center"
            android:background="@drawable/input_background"
            android:padding="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginBottom="20dp"
            android:importantForAutofill="no" />

        <!-- Connect button -->
        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/connect_display"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:background="@drawable/button_primary"
            android:focusable="true"
            android:layout_marginBottom="12dp" />

        <!-- Status text (hidden by default) -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <!-- Instructions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_1"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_2"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/step_3"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
