<?xml version="1.0" encoding="utf-8"?>
<!--
  Viewer layout: full-screen WebView with an overlay frozen badge.
  The WebView renders the server-side Game Plan TV content while the
  native app handles pairing, state polling, and navigation.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Main web content -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Frozen badge overlay (top-right, hidden by default) -->
    <TextView
        android:id="@+id/frozenBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:text="@string/frozen_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/warning"
        android:background="@drawable/frozen_badge_background"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        android:elevation="8dp" />

    <!-- Connection status overlay (centred, hidden by default) -->
    <FrameLayout
        android:id="@+id/connectionStatus"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC0A0A0F"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/reconnecting"
            android:textSize="20sp"
            android:textColor="@color/text_secondary" />
    </FrameLayout>
</FrameLayout>
