    [31m<script>[39m
    [31m// Toggle submenu expansion[39m
    [31mfunction toggleSubmenu(element) {[39m
    [31m    element.classList.toggle('expanded');[39m
    [31m    const submenu = element.nextElementSibling;[39m
    [31m    if (submenu && submenu.classList.contains('nav-submenu')) {[39m
    [31m        submenu.classList.toggle('expanded');[39m
    [31m    }[39m
    [31m}·[39m
    [31m// Persist sidebar scroll position across page loads[39m
    [31mdocument.addEventListener('DOMContentLoaded', function() {[39m
    [31m    const sidebar = document.querySelector('.sidebar');·····[39m
    [31m    // Restore scroll position from sessionStorage[39m
    [31m    const savedScrollPos = sessionStorage.getItem('sidebarScrollPos');[39m
    [31m    if (savedScrollPos && sidebar) {[39m
    [31m        sidebar.scrollTop = parseInt(savedScrollPos, 10);[39m
    [31m    }·····[39m
    [31m    // Also scroll to active nav link if it's not visible[39m
    [31m    const activeLink = sidebar?.querySelector('.nav-link.active');[39m
    [31m    if (activeLink && sidebar) {[39m
    [31m        // Check if active link is in view[39m
    [31m        const sidebarRect = sidebar.getBoundingClientRect();[39m
    [31m        const linkRect = activeLink.getBoundingClientRect();·········[39m
    [31m        // If active link is not visible, scroll to it (but keep some context)[39m
    [31m        if (linkRect.top < sidebarRect.top || linkRect.bottom > sidebarRect.bottom) {[39m
    [31m            // Only scroll if we didn't have a saved position[39m
    [31m            if (!savedScrollPos) {[39m
    [31m                activeLink.scrollIntoView({ block: 'center', behavior: 'instant' });[39m
    [31m            }[39m
    [31m        }[39m
    [31m    }·····[39m
    [31m    // Save scroll position before page unload[39m
    [31m    window.addEventListener('beforeunload', function() {[39m
    [31m        if (sidebar) {[39m
    [31m            sessionStorage.setItem('sidebarScrollPos', sidebar.scrollTop);[39m
    [31m        }[39m
    [31m    });·····[39m
    [31m    // Also save on nav link click (backup)[39m
    [31m    const navLinks = document.querySelectorAll('.sidebar .nav-link');[39m
    [31m    navLinks.forEach(link => {[39m
    [31m        link.addEventListener('click', function() {[39m
    [31m            if (sidebar) {[39m
    [31m                sessionStorage.setItem('sidebarScrollPos', sidebar.scrollTop);[39m
    [31m            }[39m
    [31m        });[39m
    [31m    });·····[39m
    [31m    // Find all active nav links in submenus[39m
    [31m    const activeSubLinks = document.querySelectorAll('.nav-submenu .nav-link.active');[39m
    [31m    activeSubLinks.forEach(link => {[39m
    [31m        const submenu = link.closest('.nav-submenu');[39m
    [31m        const parent = submenu?.previousElementSibling;[39m
    [31m        if (submenu && parent) {[39m
    [31m            submenu.classList.add('expanded');[39m
    [31m            parent.classList.add('expanded');[39m
    [31m        }[39m
    [31m    });[39m
    [31m});·[39m
    [31m// Switch athlete for parent view[39m
    [31mfunction switchAthlete(athleteId) {[39m
    [31m    if (athleteId) {[39m
    [31m        fetch('process_switch_athlete.php', {[39m
