# Arctic Wolves Video Companion Server - Environment Configuration
# Copy to .env and configure:

# API authentication key (shared with Game Plan settings)
API_KEY=changeme

# Server configuration
COMPANION_HOST=0.0.0.0
COMPANION_PORT=5100

# Video file storage base path
# Mount your NFS/SMB share to this path on both the Game Plan and Companion servers
VIDEO_BASE_PATH=/videos

# Hardware acceleration method: auto, nvenc, qsv, vaapi, amf, none
HW_ACCEL=auto

# FFmpeg paths (usually auto-detected)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Maximum parallel encoding/transcoding jobs
MAX_CONCURRENT_JOBS=2

# Temporary directory for intermediate files
TEMP_DIR=/tmp/companion

# IANA timezone (should match the main application)
TZ=America/Toronto

# S3 / RustFS configuration (for HLS transcoding pipeline)
# The companion server downloads source videos from RustFS, transcodes to HLS,
# and uploads the HLS segments back to the same bucket.
S3_ENDPOINT=https://rustfs.example.com:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_USE_SSL=true
# Set to true to enforce SSL certificate verification (recommended for production)
S3_VERIFY_SSL=false

# HLS staging watcher — monitors this S3 prefix for new video uploads and
# automatically transcodes them to HLS in the background.
HLS_STAGING_PREFIX=Images/videos/
HLS_POLL_INTERVAL=30
