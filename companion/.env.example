# Arctic Wolves Video Companion Server - Environment Configuration
# Copy to .env and configure the minimal required settings below.
#
# The companion is a worker/integration service for the main Arctic Wolves
# application. Most settings (S3/RustFS credentials, video paths, HLS config)
# are managed through the companion's web UI at http://localhost:5100 and
# stored in an encrypted config file on the persistent volume.
#
# On first run, visit the companion dashboard to generate an API key, then
# enter that key in the main application under Game Plan Settings → Companion
# Server → API Key.

# ── Encryption Key ─────────────────────────────────────────────────────────
# AES-256-CBC key used to encrypt the persistent config file.
# Must match the ENCRYPTION_KEY in the main application's arctic_wolves.env
# so both apps use the same PII encryption.
# Generate with: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# ── Server ─────────────────────────────────────────────────────────────────
COMPANION_HOST=0.0.0.0
COMPANION_PORT=5100

# ── Hardware Acceleration ──────────────────────────────────────────────────
# Method: auto, nvenc, qsv, vaapi, amf, none
HW_ACCEL=auto

# Maximum parallel encoding/transcoding jobs
MAX_CONCURRENT_JOBS=2

# ── Timezone ───────────────────────────────────────────────────────────────
# IANA timezone — should match the main application
TZ=America/Toronto

# ── Advanced / Override ────────────────────────────────────────────────────
# The following settings are normally managed via the companion web UI and
# stored in the encrypted persistent config. Set them here ONLY if you need
# to override the persisted values (e.g. for CI or headless deployments).
#
# API_KEY           — Generated by the companion; enter in main app settings.
# MAIN_APP_URL      — URL of the main Arctic Wolves application (for callbacks).
# VIDEO_BASE_PATH   — Derived from the RustFS integration; default /videos.
# S3_ENDPOINT       — Provided by the main app's RustFS settings.
# S3_ACCESS_KEY     — Provided by the main app's RustFS settings.
# S3_SECRET_KEY     — Provided by the main app's RustFS settings.
# S3_BUCKET         — Provided by the main app's RustFS settings.
# S3_REGION         — Provided by the main app's RustFS settings.
# S3_USE_SSL        — Provided by the main app's RustFS settings.
# S3_VERIFY_SSL     — Provided by the main app's RustFS settings.
# HLS_STAGING_PREFIX — Derived from the RustFS video storage path.
# HLS_POLL_INTERVAL  — Watcher poll interval in seconds (default 30).
