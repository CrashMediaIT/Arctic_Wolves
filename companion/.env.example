# Arctic Wolves Video Companion Server - Environment Configuration
# Copy to .env and configure:

# API authentication key (shared with Game Plan settings)
API_KEY=changeme

# Server configuration
COMPANION_HOST=0.0.0.0
COMPANION_PORT=5100

# Video file storage base path
# Mount your NFS/SMB share to this path on both the Game Plan and Companion servers
VIDEO_BASE_PATH=/videos

# Hardware acceleration method: auto, nvenc, qsv, vaapi, amf, none
HW_ACCEL=auto

# FFmpeg paths (usually auto-detected)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Maximum parallel encoding/transcoding jobs
MAX_CONCURRENT_JOBS=2

# Temporary directory for intermediate files
TEMP_DIR=/tmp/companion
