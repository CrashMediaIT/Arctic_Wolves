# Arctic Wolves Video Companion Server - Environment Configuration
# Copy to .env and configure the minimal required settings below.
#
# The companion is a worker/integration service for the main Arctic Wolves
# application.  It handles hardware-accelerated video transcoding to HLS.
#
# ── Setup flow ─────────────────────────────────────────────────────────────
#   1. Set the ENCRYPTION_KEY below (must match the main application).
#   2. Start the container: docker compose up -d
#   3. Visit http://localhost:5100 → Settings to generate an API key.
#   4. Enter the generated key in the main app's Game Plan Settings →
#      Companion Server → API Key.
#   5. In the main app's RustFS settings, click "Push to Companion" to
#      send the S3/RustFS connection credentials.
#
# All other settings (API key, RustFS credentials, main app URL) are entered
# via the companion web UI and stored in an AES-256-CBC encrypted config file
# on the persistent Docker volume (/config).
#
# Storage paths (where videos live, where HLS output goes) are controlled
# entirely by the main application — it tells the companion exactly where
# each source file is and where to write the transcoded output.

# ── Encryption Key (required) ──────────────────────────────────────────────
# AES-256-CBC key used to encrypt the persistent config file.
# Must match the ENCRYPTION_KEY in the main application's arctic_wolves.env
# so both apps use the same PII encryption scheme.
# Generate with: python -c "import os; print(os.urandom(32).hex())"
ENCRYPTION_KEY=

# ── Server ─────────────────────────────────────────────────────────────────
COMPANION_HOST=0.0.0.0
COMPANION_PORT=5100

# ── Hardware Acceleration ──────────────────────────────────────────────────
# Method: auto, nvenc, qsv, vaapi, amf, none
HW_ACCEL=auto

# Maximum parallel encoding/transcoding jobs
MAX_CONCURRENT_JOBS=2

# ── Timezone ───────────────────────────────────────────────────────────────
# IANA timezone — should match the main application
TZ=America/Toronto

# ── Advanced / Override ────────────────────────────────────────────────────
# The following are normally managed via the companion web UI and persisted
# in the encrypted config file. Set them here ONLY to override persisted
# values (e.g. for CI or headless deployments).
#
# API_KEY        — Generated by the companion; enter in main app settings.
# MAIN_APP_URL   — URL of the main app (for transcode-complete callbacks).
# S3_ENDPOINT    — RustFS endpoint (pushed from main app or entered in UI).
# S3_ACCESS_KEY  — RustFS access key.
# S3_SECRET_KEY  — RustFS secret key.
# S3_BUCKET      — RustFS bucket name.
# S3_REGION      — RustFS region (default us-east-1).
# S3_USE_SSL     — Use HTTPS for RustFS (default true).
# S3_VERIFY_SSL  — Verify SSL certificate (default false).
